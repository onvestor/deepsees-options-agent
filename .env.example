# DeepSees Options Agent — environment template.
# Copy to `.env` and fill in. `.env` is gitignored; this file must never
# contain a real key.

# --- Alpaca (paper) --------------------------------------------------------
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Anthropic -------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Optional overrides ----------------------------------------------------
# Directory holding limits.yaml / universe.yaml. Defaults to <repo>/config.
# DEEPSEES_CONFIG_DIR=
# Directory for decision_log.jsonl. Defaults to <repo>/logs.
# DEEPSEES_LOG_DIR=
# Directory holding agent prompt text. Defaults to <repo>/prompts.
# DEEPSEES_PROMPT_DIR=
