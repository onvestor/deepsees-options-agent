# DeepSees Options Agent — environment template.
# Copy to `.env` and fill in. `.env` is gitignored; this file must never
# contain a real key.
#
# SCOPE: credentials and endpoints ONLY. Anything that changes trading
# behaviour — including data feeds — belongs in config/limits.yaml, which is
# the single source for behaviour. Do not reintroduce feed selection here.
#
# Validation is per consumer: broker workflows need the ALPACA_* keys, agent
# calls need ANTHROPIC_API_KEY. Neither demands the other.

# --- Alpaca (paper) --------------------------------------------------------
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# Market-data host. Optional; overrides the SDK default when set.
ALPACA_DATA_URL=https://data.alpaca.markets

# Refuse every broker write (orders, cancels) while set to a truthy value.
# Reads stay live. For driving a session without touching the broker.
ALPACA_MOCK=false

# --- Financial Modeling Prep (earnings calendar) ---------------------------
# Required only for the earnings exclusion. Broker-only steps run without it.
FMP_API_KEY=

# --- Anthropic -------------------------------------------------------------
# Required only when an agent is invoked. Broker-only steps run without it.
ANTHROPIC_API_KEY=

# --- Optional path overrides -----------------------------------------------
# DEEPSEES_CONFIG_DIR=
# DEEPSEES_LOG_DIR=
# DEEPSEES_PROMPT_DIR=
